#!/usr/bin/env bash
# devbox: per-project Incus VMs for Claude Code and opencode, cloned from one shared base image.
#
#   <project> VMs ──tcp/3128 only──▶ devbox-proxy (container, squid allowlist) ──▶ internet
#      │  "devbox-net": isolated bridge, no NAT, no routing, no default route, no DNS
#      └─ virtiofs mount of the project folder at the same path as on the host
#
#   devbox-base (image) ──btrfs CoW clone──▶ one VM per project
#
# Run "devbox help" for the command list.
set -euo pipefail

# ── configuration (override with environment variables) ─────────────────────
BASE_SOURCE="${DEVBOX_BASE_SOURCE:-images:ubuntu/26.04}"
BASE_ALIAS="${DEVBOX_BASE_ALIAS:-devbox-base}"
BASE_DISK="${DEVBOX_BASE_DISK:-20GiB}"
PROXY_IMAGE="${DEVBOX_PROXY_IMAGE:-images:debian/13}"
VM_CPUS="${DEVBOX_CPUS:-8}"
VM_MEM="${DEVBOX_MEM:-16GiB}"
VM_DISK="${DEVBOX_DISK:-80GiB}"
POOL="${DEVBOX_POOL:-default}"
POOL_SIZE="${DEVBOX_POOL_SIZE:-300GiB}"        # sparse loop file, only if the pool is created here
SANDBOX_NET="${DEVBOX_SANDBOX_NET:-devbox-net}"
SANDBOX_CIDR="${DEVBOX_SANDBOX_CIDR:-10.213.88.1/24}"
UPLINK_NET="${DEVBOX_UPLINK_NET:-devbox-up}"
UPLINK_CIDR="${DEVBOX_UPLINK_CIDR:-10.213.89.1/24}"
PROXY="devbox-proxy"
BUILDER="devbox-builder"
PROFILE="devbox"
ACL="devbox-egress"
KEY="user.devbox.project"                       # instance config key holding the project path

# ── derived values ──────────────────────────────────────────────────────────
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
HOST_USER="$(id -un)"; HOST_UID="$(id -u)"; HOST_GID="$(id -g)"
SANDBOX_GW="${SANDBOX_CIDR%/*}"
SANDBOX_PREFIX="${SANDBOX_CIDR#*/}"
SANDBOX_BASE="${SANDBOX_GW%.*}"
SANDBOX_SUBNET="${SANDBOX_BASE}.0/${SANDBOX_PREFIX}"
PROXY_IP="${SANDBOX_BASE}.2"
PROXY_URL="http://${PROXY_IP}:3128"
DHCP_RANGE="${SANDBOX_BASE}.100-${SANDBOX_BASE}.250"
CRED_PATH="/home/$HOST_USER/.claude/.credentials.json"
GH_PATH="/home/$HOST_USER/.config/gh/hosts.yml"
OC_AUTH_PATH="/home/$HOST_USER/.local/share/opencode/auth.json"
CONFIG_DIR="${DEVBOX_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/devbox}"
DEFAULT_DOMAINS="$HERE/default-allowed-domains.txt"   # shipped with devbox
USER_DOMAINS="$CONFIG_DIR/domains.txt"                # yours: extra allows, and denies
DOMAIN_RE='^\.?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$'  # a domain-list entry, without "!"

VM=""; PROJECT_DIR=""; CONSUMED=0

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m  %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m  %s\n' "$*" >&2; exit 1; }

need_incus() {
  command -v incus >/dev/null || die "incus is not installed; run: devbox setup"
  incus info >/dev/null 2>&1 || die "cannot reach incus; are you in incus-admin (log out/in after setup)?"
}
exists()  { incus info "$1" >/dev/null 2>&1; }
state()   { incus list "^$1\$" -c s -f csv 2>/dev/null; }
project_of() { incus config get "$1" "$KEY" 2>/dev/null || true; }
is_devbox()  { [[ -n $(project_of "$1") ]]; }
devbox_vms() {
  local n
  while read -r n; do
    if is_devbox "$n"; then echo "$n"; fi
  done < <(incus list -f csv -c n type=virtual-machine 2>/dev/null)
}
base_fingerprint() { incus image info "$BASE_ALIAS" 2>/dev/null | awk '/^Fingerprint:/ {print $2}'; }

# Pick the VM: an explicit first argument if it names a devbox VM, otherwise
# the VM whose project folder contains the current directory (deepest match).
resolve_vm() {
  CONSUMED=0
  if [[ $# -ge 1 ]] && is_devbox "$1"; then
    VM="$1"; CONSUMED=1
  else
    local n p bestlen=0
    VM=""
    while read -r n; do
      p="$(project_of "$n")"
      if [[ ($PWD == "$p" || $PWD == "$p"/*) && ${#p} -gt $bestlen ]]; then VM="$n"; bestlen=${#p}; fi
    done < <(devbox_vms)
    [[ -n $VM ]] || die "no devbox VM for $PWD; pass a VM name (see: devbox list)"
  fi
  PROJECT_DIR="$(project_of "$VM")"
}

wait_agent() {
  local _
  for _ in $(seq 180); do
    if incus exec "$1" -- true </dev/null >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  die "$1 did not become ready"
}

vm_ip() {
  local _ ip
  for _ in $(seq 60); do
    ip="$(incus list "^$1\$" -c 4 -f csv | awk '{print $1}')"
    if [[ -n $ip ]]; then echo "$ip"; return 0; fi
    sleep 1
  done
  die "$1 got no IP address"
}

ensure_proxy_running() {
  exists "$PROXY" || die "proxy missing; run: devbox build-base"
  if [[ $(state "$PROXY") != RUNNING ]]; then incus start "$PROXY"; fi
}

ensure_running() { # $1 = VM
  ensure_proxy_running
  ensure_nic_filtering "$1"
  if [[ $(state "$1") != RUNNING ]]; then incus start "$1"; fi
  wait_agent "$1"
}

# Run a command in $VM as the mirrored host user, in the project folder
# (or the matching subdirectory when called from inside the project).
vm_exec() {
  local tty="$1"; shift
  local cwd="$PROJECT_DIR"
  if [[ -n $cwd && ($PWD == "$cwd" || $PWD == "$cwd"/*) ]]; then cwd="$PWD"; fi
  incus exec "$VM" "$tty" --user "$HOST_UID" --group "$HOST_GID" --cwd "${cwd:-/home/$HOST_USER}" \
    --env HOME="/home/$HOST_USER" --env USER="$HOST_USER" --env LOGNAME="$HOST_USER" \
    --env TERM="${TERM:-xterm-256color}" \
    -- bash -lc 'exec "$@"' bash "$@"
}
in_vm() { if [[ -t 0 && -t 1 ]]; then vm_exec -t "$@"; else vm_exec -T "$@"; fi; }

# The proxy is either locked to the allowlist, or open for exactly one instance.
proxy_open_for() {
  local ip; ip="$(vm_ip "$1")"
  incus exec "$PROXY" -- sh -c \
    "printf 'acl opened src %s/32\nhttp_access allow opened\n' '$ip' > /etc/squid/devbox-mode.conf && squid -k reconfigure"
  sleep 1
}
proxy_lock() {
  incus exec "$PROXY" -- sh -c \
    "echo '# locked: only domains in allowed-domains.txt' > /etc/squid/devbox-mode.conf && squid -k reconfigure"
  sleep 1
}

# ── domain lists: defaults + the user's file → squid dstdomain files ───────────
ensure_user_domains() {
  if [[ -e $USER_DOMAINS ]]; then return 0; fi
  mkdir -p "$CONFIG_DIR"
  cat >"$USER_DOMAINS" <<'EOF'
# Your devbox domains, merged with default-allowed-domains.txt from the devbox folder.
#   .example.com      allow example.com and all its subdomains
#   example.com       allow exactly example.com
#   !.example.com     deny; wins over the defaults and over an allowed parent (e.g. !gist.github.com)
# After editing: devbox reload-proxy    (or use: devbox allow <domain> / devbox deny <domain>)
EOF
  log "Created $USER_DOMAINS"
}

write_domain_lists() { # allowed file, denied file
  ensure_user_domains
  local f line n out bad=()
  : >"$1"; : >"$2"
  for f in "$DEFAULT_DOMAINS" "$USER_DOMAINS"; do
    n=0
    while IFS= read -r line || [[ -n $line ]]; do
      n=$((n + 1))
      line="${line%%#*}"; line="${line//[[:space:]]/}"; line="${line,,}"
      if [[ -z $line ]]; then continue; fi
      if [[ ! ${line#!} =~ $DOMAIN_RE ]]; then bad+=("$f:$n: $line"); continue; fi
      if [[ $line == '!'* ]]; then echo "${line#!}" >>"$2"; else echo "$line" >>"$1"; fi
    done <"$f"
  done
  if [[ ${#bad[@]} -gt 0 ]]; then
    warn "Not a domain (no scheme, path, port, wildcard or trailing dot):"
    printf '      %s\n' "${bad[@]}" >&2
    die "Delete or fix these lines, then run: devbox reload-proxy"
  fi
  # .invalid (reserved, never resolves) keeps the deny list from being empty, which squid warns about.
  echo .invalid >>"$2"
  # squid drops one of two overlapping entries (a.b.com under .b.com), so keep only the widest.
  for out in "$1" "$2"; do
    awk '{ s[$0] = 1 }
      END {
        for (e in s) {
          h = e; sub(/^\./, "", h); covered = (e !~ /^\./ && ("." h) in s)
          n = split(h, p, "."); suf = ""
          for (i = n; i > 1; i--) { suf = (suf == "" ? p[i] : p[i] "." suf); if (("." suf) in s) covered = 1 }
          if (!covered) print e
        }
      }' "$out" | sort >"$out.tmp"
    mv "$out.tmp" "$out"
  done
}

push_domain_lists() { # directory in the proxy
  local tmp; tmp="$(mktemp -d)"
  write_domain_lists "$tmp/allowed-domains.txt" "$tmp/denied-domains.txt"
  incus file push --uid 0 --gid 0 --mode 0644 "$tmp/allowed-domains.txt" "$PROXY$1/allowed-domains.txt"
  incus file push --uid 0 --gid 0 --mode 0644 "$tmp/denied-domains.txt" "$PROXY$1/denied-domains.txt"
  rm -rf "$tmp"
}

# MAC and IPv4 filtering pin each instance to its own addresses. Without them, root in a VM
# could take the IP the proxy is opened for (unlock/update/build-base), or the proxy's own IP.
add_sandbox_nic() {
  incus config device add "$1" eth0 nic network="$SANDBOX_NET" \
    security.acls="$ACL" \
    security.acls.default.egress.action=reject \
    security.acls.default.ingress.action=reject \
    security.mac_filtering=true security.ipv4_filtering=true >/dev/null
}

nic_filtered() { # $1 = instance
  [[ $(incus config device get "$1" eth0 security.mac_filtering 2>/dev/null) == true &&
     $(incus config device get "$1" eth0 security.ipv4_filtering 2>/dev/null) == true ]]
}

ensure_nic_filtering() { # $1 = VM; turns filtering on for VMs created before it was added
  if nic_filtered "$1"; then return 0; fi
  log "Enabling MAC/IPv4 anti-spoofing filters on $1"
  if ! incus config device set "$1" eth0 security.mac_filtering=true security.ipv4_filtering=true; then
    warn "could not enable the filters on running $1; run: devbox stop $1, then use it again"
  fi
}

push_run() { # instance, local file, args...: copy a script in and run it as root
  local inst="$1" file="$2"; shift 2
  incus file push --uid 0 --gid 0 --mode 0755 "$file" "$inst/root/${file##*/}"
  incus exec "$inst" -- "/root/${file##*/}" "$@"
}

# ── host setup and shared infrastructure ────────────────────────────────────
cmd_setup() {
  [[ $EUID -ne 0 ]] || die "run as your normal user; sudo is used where needed"
  [[ -e /dev/kvm ]] || die "/dev/kvm is missing; enable VT-x/AMD-V in firmware"
  log "Installing Incus, QEMU, OVMF and virtiofsd"
  sudo pacman -S --needed incus qemu-full edk2-ovmf virtiofsd
  log "Configuring subordinate ids for unprivileged containers"
  local f
  for f in /etc/subuid /etc/subgid; do
    if ! sudo grep -qx 'root:1000000:1000000000' "$f" 2>/dev/null; then
      echo 'root:1000000:1000000000' | sudo tee -a "$f" >/dev/null
    fi
  done
  sudo systemctl enable --now incus.socket
  sudo systemctl try-restart incus.service
  if getent group incus-admin | grep -qw "$HOST_USER"; then
    log "Host ready. Next: devbox build-base"
  else
    sudo usermod -aG incus-admin "$HOST_USER"
    log "Added $HOST_USER to incus-admin. Log out and back in, then run: devbox build-base"
  fi
}

ensure_infra() {
  if ! incus storage show "$POOL" >/dev/null 2>&1; then
    log "Creating storage pool $POOL (btrfs on a sparse $POOL_SIZE loop file)"
    incus storage create "$POOL" btrfs size="$POOL_SIZE"
  fi
  local driver; driver="$(incus storage show "$POOL" | awk '/^driver:/ {print $2}')"
  if [[ $driver != btrfs && $driver != zfs ]]; then
    warn "pool '$POOL' uses '$driver': VMs will be full copies of the base, not CoW clones"
  fi
  if ! incus profile show "$PROFILE" >/dev/null 2>&1; then
    incus profile create "$PROFILE"
    incus profile device add "$PROFILE" root disk path=/ pool="$POOL" >/dev/null
  fi
  # Instances stay stopped after a host reboot; devbox starts them on demand.
  if [[ $(incus profile get "$PROFILE" boot.autostart) != false ]]; then
    incus profile set "$PROFILE" boot.autostart=false
  fi
  if ! incus network show "$UPLINK_NET" >/dev/null 2>&1; then
    log "Creating uplink network $UPLINK_NET (NAT; only the proxy is attached)"
    incus network create "$UPLINK_NET" ipv4.address="$UPLINK_CIDR" ipv4.nat=true ipv6.address=none
  fi
  if ! incus network show "$SANDBOX_NET" >/dev/null 2>&1; then
    log "Creating isolated sandbox network $SANDBOX_NET"
    incus network create "$SANDBOX_NET" \
      ipv4.address="$SANDBOX_CIDR" ipv4.nat=false ipv4.routing=false ipv6.address=none \
      ipv4.dhcp.ranges="$DHCP_RANGE" \
      raw.dnsmasq="$(printf 'dhcp-option=3\ndhcp-option=6')"   # no default route, no DNS server
  fi
  if ! incus network acl show "$ACL" >/dev/null 2>&1; then
    log "Creating egress ACL $ACL"
    incus network acl create "$ACL"
    incus network acl rule add "$ACL" egress action=allow protocol=tcp \
      destination="$PROXY_IP/32" destination_port=3128 "description=squid proxy"
    incus network acl rule add "$ACL" egress action=allow protocol=udp \
      destination="$SANDBOX_GW/32,255.255.255.255/32" destination_port=67 "description=DHCP"
    incus network acl rule add "$ACL" ingress action=allow protocol=udp \
      destination_port=68 "description=DHCP replies"
  fi
  if command -v ufw >/dev/null && sudo ufw status 2>/dev/null | grep -q '^Status: active'; then
    log "Ensuring ufw rules (uplink: DHCP/DNS and forwarding; sandbox: DHCP and intra-bridge only)"
    sudo ufw allow in on "$UPLINK_NET" comment 'devbox uplink' >/dev/null
    sudo ufw route allow in on "$UPLINK_NET" comment 'devbox uplink' >/dev/null
    sudo ufw route allow out on "$UPLINK_NET" comment 'devbox uplink' >/dev/null
    sudo ufw allow in on "$SANDBOX_NET" to any port 67 proto udp comment 'devbox DHCP' >/dev/null
    sudo ufw route allow in on "$SANDBOX_NET" out on "$SANDBOX_NET" comment 'devbox intra-bridge' >/dev/null
  fi
}

ensure_proxy() {
  if exists "$PROXY"; then ensure_proxy_running; return 0; fi
  log "Creating proxy container $PROXY"
  incus init "$PROXY_IMAGE" "$PROXY" -p "$PROFILE"
  incus config device add "$PROXY" eth0 nic network="$UPLINK_NET" >/dev/null
  incus config device add "$PROXY" eth1 nic network="$SANDBOX_NET" ipv4.address="$PROXY_IP" >/dev/null
  incus start "$PROXY"
  wait_agent "$PROXY"
  push_domain_lists /root
  push_run "$PROXY" "$HERE/provision-proxy.sh" "$SANDBOX_SUBNET" "$PROXY_IP/$SANDBOX_PREFIX"
}

# ── base image ──────────────────────────────────────────────────────────────
cmd_build_base() {
  ensure_infra
  ensure_proxy
  if exists "$BUILDER"; then incus delete -f "$BUILDER"; fi
  log "Building base image '$BASE_ALIAS' from $BASE_SOURCE"
  incus init "$BASE_SOURCE" "$BUILDER" --vm -p "$PROFILE" -c limits.cpu="$VM_CPUS" -c limits.memory="$VM_MEM"
  incus config device override "$BUILDER" root size="$BASE_DISK" >/dev/null
  add_sandbox_nic "$BUILDER"
  incus start "$BUILDER"
  wait_agent "$BUILDER"

  log "Provisioning (proxy open for the builder only)"
  proxy_open_for "$BUILDER"
  trap 'proxy_lock' EXIT
  push_run "$BUILDER" "$HERE/provision-base.sh" "$HOST_USER" "$HOST_UID" "$HOST_GID" "$PROXY_URL" \
    "$(git config --global user.name || true)" "$(git config --global user.email || true)"
  incus exec "$BUILDER" -- bash -c \
    'apt-get clean; rm -rf /var/lib/apt/lists/* /root/*.sh; truncate -s 0 /etc/machine-id; rm -f /var/lib/dbus/machine-id; fstrim -a || true'
  proxy_lock
  trap - EXIT

  incus stop "$BUILDER"
  log "Publishing image (takes a few minutes)"
  incus publish "$BUILDER" --alias "$BASE_ALIAS" --reuse --compression zstd \
    "description=devbox base for $HOST_USER, built $(date -I)"
  incus delete "$BUILDER"
  log "Base image ready. Create a project VM with: devbox create <name> <path>"
  stale_note
}

stale_note() {
  local cur n stale=()
  cur="$(base_fingerprint)"
  while read -r n; do
    if [[ $(incus config get "$n" volatile.base_image) != "$cur" ]]; then stale+=("$n"); fi
  done < <(devbox_vms)
  if [[ ${#stale[@]} -gt 0 ]]; then
    warn "on an older base: ${stale[*]}  (devbox recreate <name> to move them over)"
  fi
}

# ── project VMs ─────────────────────────────────────────────────────────────
cmd_create() {
  local name="${1:-}" path="${2:-$PWD}"
  [[ $name =~ ^[a-z][a-z0-9-]{0,62}$ ]] \
    || die "usage: devbox create <name> [path]   (name: lowercase letters, digits, hyphens)"
  path="$(realpath -e "$path" 2>/dev/null)" || die "path not found: ${2:-$PWD}"
  [[ -d $path ]] || die "not a directory: $path"
  if exists "$name"; then die "$name already exists"; fi
  local n
  while read -r n; do
    [[ $(project_of "$n") != "$path" ]] || die "$path is already served by VM '$n'"
  done < <(devbox_vms)

  ensure_infra
  ensure_proxy
  if [[ -z $(base_fingerprint) ]]; then log "No base image yet"; cmd_build_base; fi

  log "Creating $name for $path ($VM_CPUS vCPU, $VM_MEM RAM, $VM_DISK disk)"
  incus init "$BASE_ALIAS" "$name" --vm -p "$PROFILE" \
    -c limits.cpu="$VM_CPUS" -c limits.memory="$VM_MEM" -c "$KEY=$path"
  incus config device override "$name" root size="$VM_DISK" >/dev/null
  add_sandbox_nic "$name"
  incus config device add "$name" project disk source="$path" path="$path" >/dev/null
  incus start "$name"
  wait_agent "$name"

  # The mount creates missing parent directories as root; hand those to the user.
  incus exec "$name" -- bash -c \
    'h="/home/$1"; d="$(dirname "$2")"; while [[ $d == "$h"/* ]]; do chown "$1:$1" "$d"; d="$(dirname "$d")"; done' \
    _ "$HOST_USER" "$path"

  VM="$name"; PROJECT_DIR="$path"
  if [[ -f $path/rust-toolchain.toml || -f $path/rust-toolchain ]]; then
    log "Installing the project's pinned Rust toolchain"
    vm_exec -T rustup toolchain install || warn "toolchain install failed; retry with: devbox run $name rustup toolchain install"
  fi
  cmd_verify
  log "Done. Start Claude Code with: devbox claude $name   (or just 'devbox claude' inside $path)"
  log "      or opencode with:       devbox opencode $name"
}

push_user_file() { # local file, vm, path in vm: write a private file owned by the user
  incus exec "$2" -- install -d -o "$HOST_UID" -g "$HOST_GID" -m 0700 "$(dirname "$3")"
  incus file push --uid "$HOST_UID" --gid "$HOST_GID" --mode 0600 "$1" "$2$3"
}

copy_credentials() { # from, to: Claude Code and opencode login tokens only, nothing executable
  local tmp path what
  tmp="$(mktemp)"
  for path in "$CRED_PATH" "$OC_AUTH_PATH"; do
    what="Claude Code"; [[ $path == "$OC_AUTH_PATH" ]] && what="opencode"
    if incus file pull "$1$path" "$tmp" 2>/dev/null && [[ -s $tmp ]]; then
      push_user_file "$tmp" "$2" "$path"
      log "Copied the $what login from $1 to $2"
    else
      warn "no $what login found in $1"
    fi
  done
  rm -f "$tmp"
}

cmd_recreate() {
  resolve_vm "$@"
  local name="$VM" path="$PROJECT_DIR"
  log "Recreating $name from the current base (project folder is untouched)"
  ensure_running "$name"
  # Carry over logins only (data, nothing executable): Claude Code, opencode and gh.
  local cred oc gh
  cred="$(mktemp)"; oc="$(mktemp)"; gh="$(mktemp)"
  incus file pull "$name$CRED_PATH" "$cred" 2>/dev/null || : >"$cred"
  incus file pull "$name$OC_AUTH_PATH" "$oc" 2>/dev/null || : >"$oc"
  incus file pull "$name$GH_PATH" "$gh" 2>/dev/null || : >"$gh"
  incus delete -f "$name"
  cmd_create "$name" "$path"
  if [[ -s $cred ]]; then push_user_file "$cred" "$name" "$CRED_PATH"; log "Kept the Claude Code login"; fi
  if [[ -s $oc ]]; then push_user_file "$oc" "$name" "$OC_AUTH_PATH"; log "Kept the opencode login"; fi
  if [[ -s $gh ]]; then push_user_file "$gh" "$name" "$GH_PATH"; log "Kept the gh login"; fi
  rm -f "$cred" "$oc" "$gh"
}

cmd_gh_login() {
  # Read the token before touching the VM: incus exec forwards stdin and would consume it.
  local token
  if [[ -t 0 ]]; then
    read -rsp "Fine-grained GitHub token for $VM: " token; echo
  else
    token="$(cat)"
  fi
  token="${token//[$'\t\r\n ']/}"
  [[ -n $token ]] || die "empty token"
  ensure_running "$VM"
  printf '%s\n' "$token" | vm_exec -T gh auth login --hostname github.com --with-token
  vm_exec -T gh auth status
}

cmd_list() {
  local cur n base mark
  cur="$(base_fingerprint)"
  printf '%-20s %-9s %-14s %s\n' NAME STATE BASE PROJECT
  while read -r n; do
    base="$(incus config get "$n" volatile.base_image)"
    mark="current"; [[ $base == "$cur" ]] || mark="older"
    printf '%-20s %-9s %-14s %s\n' "$n" "$(state "$n")" "$mark" "$(project_of "$n")"
  done < <(devbox_vms)
  if exists "$PROXY"; then
    printf '\nproxy: %s, ' "$(state "$PROXY")"
    if [[ $(state "$PROXY") == RUNNING ]] && incus exec "$PROXY" -- grep -q '^http_access' /etc/squid/devbox-mode.conf; then
      echo "OPEN for one instance (devbox lock)"
    else
      echo "locked to the allowlist"
    fi
  fi
}

bad=0
expect() { # expect <pass|fail> <description> <shell snippet run in the VM>
  local want="$1" desc="$2" got=fail
  if vm_exec -T bash -c "$3" >/dev/null 2>&1; then got=pass; fi
  if [[ $got == "$want" ]]; then printf '  ok    %s\n' "$desc"; else printf '  FAIL  %s\n' "$desc"; bad=1; fi
}

cmd_verify() {
  ensure_running "$VM"
  log "Checking containment from inside $VM"
  bad=0
  if nic_filtered "$VM"; then printf '  ok    %s\n' "MAC/IPv4 anti-spoofing filters on the NIC"
  else printf '  FAIL  %s\n' "MAC/IPv4 anti-spoofing filters on the NIC (devbox stop $VM; devbox start $VM)"; bad=1; fi
  expect fail "no direct internet access (bypassing the proxy)" \
    'curl -sS --max-time 5 --noproxy "*" -o /dev/null http://1.1.1.1'
  expect fail "no DNS resolution inside the VM" \
    'timeout 5 getent hosts example.com'
  expect fail "host is not reachable on the sandbox bridge (tcp/53)" \
    "timeout 3 bash -c '</dev/tcp/$SANDBOX_GW/53'"
  expect fail "proxy refuses a non-allowlisted domain" \
    'curl -sS --max-time 10 -o /dev/null https://example.com'
  expect pass "proxy allows api.anthropic.com" \
    'curl -sS --max-time 10 -o /dev/null https://api.anthropic.com'
  expect pass "proxy allows the crates.io index" \
    'curl -sSf --max-time 10 -o /dev/null https://index.crates.io/config.json'
  if vm_exec -T ip route show default 2>/dev/null | grep -q .; then
    warn "VM has a default route; the bridge does not route, but this was not expected"
  fi
  if [[ $bad -ne 0 ]]; then die "containment checks failed; do not use $VM until this is fixed"; fi
  log "All containment checks passed"
}

cmd_update() {
  ensure_running "$VM"
  log "Updating OS packages and Rust in $VM (through the allowlist)"
  incus exec "$VM" -- bash -c 'apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get -yq full-upgrade'
  vm_exec -T rustup update
  log "Updating Claude Code, opencode and cargo-nextest (proxy open for $VM only; don't run them meanwhile)"
  proxy_open_for "$VM"
  trap 'proxy_lock' EXIT
  vm_exec -T claude update || warn "claude update failed"
  vm_exec -T cargo nextest self update || warn "cargo-nextest update failed"
  if vm_exec -T bash -c 'command -v opencode' >/dev/null 2>&1; then
    vm_exec -T opencode upgrade || warn "opencode upgrade failed"
  else
    warn "opencode is not installed in $VM (its base predates it); devbox recreate $VM to get it"
  fi
  proxy_lock
  trap - EXIT
  log "Proxy locked again"
}

cmd_reload_proxy() {
  ensure_proxy_running
  push_domain_lists /etc/squid
  # Proxies built before deny support lack the rule: add it just before the allow.
  incus exec "$PROXY" -- sh -c 'grep -q denied-domains /etc/squid/squid.conf || sed -i \
    "s|^http_access allow allowed\$|acl denied dstdomain \"/etc/squid/denied-domains.txt\"\nhttp_access deny denied\n&|" \
    /etc/squid/squid.conf' </dev/null
  if ! incus exec "$PROXY" -- squid -k parse </dev/null >/dev/null 2>&1; then
    incus exec "$PROXY" -- squid -k parse </dev/null 2>&1 | grep -iE 'error|fatal' >&2 || true
    die "squid rejected the new config; the running proxy keeps the old lists until fixed"
  fi
  incus exec "$PROXY" -- squid -k reconfigure </dev/null
  log "Proxy domain lists reloaded ($DEFAULT_DOMAINS + $USER_DOMAINS)"
}

cmd_allow_deny() { # allow|deny <domain>...: record in the user's file; one replaces the other
  local mode="$1"; shift
  [[ $# -ge 1 ]] || die "usage: devbox $mode <domain>..."
  ensure_user_domains
  local d tmp
  for d in "$@"; do
    d="${d,,}"
    [[ .${d#.} =~ $DOMAIN_RE ]] || die "not a domain: $d (give a bare name like example.com: no scheme, path, port, wildcard or trailing dot)"
  done
  for d in "$@"; do
    d="${d,,}"; d=".${d#.}"
    tmp="$(mktemp)"
    grep -vxF -e "$d" -e "!$d" "$USER_DOMAINS" >"$tmp" || true
    if [[ $mode == deny ]]; then d="!$d"; fi
    printf '%s\n' "$d" >>"$tmp"
    cat "$tmp" >"$USER_DOMAINS"
    rm -f "$tmp"
  done
  cmd_reload_proxy
}

cmd_denied() {
  ensure_proxy_running
  local filter=""
  if [[ -n $VM ]]; then filter="$(vm_ip "$VM")"; fi
  incus exec "$PROXY" -- awk -v ip="$filter" '$3 ~ /DENIED/ && (ip == "" || $2 == ip) {print $5}' /var/log/squid/access.log \
    | sed -E 's#^[a-z]+://##; s#[:/].*$##' | sort | uniq -c | sort -rn
}

cmd_audit() {
  local g=(git -C "$PROJECT_DIR" -c core.fsmonitor=false -c core.hooksPath=/dev/null)
  local found=0 h out
  log "Auditing $PROJECT_DIR"
  log "Git hooks in .git/hooks (these run on the host)"
  shopt -s nullglob
  for h in "$PROJECT_DIR"/.git/hooks/*; do
    if [[ $h != *.sample ]]; then echo "  $h"; found=1; fi
  done
  log "Repo-local git config that can execute commands"
  out="$("${g[@]}" config --local --list 2>/dev/null | grep -iE \
    '^(core\.(hookspath|fsmonitor|sshcommand|pager|editor|askpass|gitproxy)|sequence\.editor|diff\..+\.(command|textconv)|filter\.|merge\..+\.driver|credential\.|alias\.[^=]+=!|include\.|includeif\.|gpg\.|uploadpack\.)' || true)"
  if [[ -n $out ]]; then echo "$out" | sed 's/^/  /'; found=1; fi
  log "Uncommitted changes to files that run code on the host (build scripts, cargo config, deps, tooling)"
  local paths=(':(glob)**/build.rs' ':(glob)**/Cargo.toml' 'Cargo.lock' ':(glob)**/.cargo/**'
               'rust-toolchain' 'rust-toolchain.toml' '.envrc' ':(glob)**/.vscode/**'
               ':(glob)**/Makefile' 'justfile' '.github')
  out="$("${g[@]}" status --porcelain --untracked-files=all -- "${paths[@]}" || true)"
  if [[ -n $out ]]; then echo "$out" | sed 's/^/  /'; found=1; fi
  if "${g[@]}" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    log "Unpushed commits touching those files"
    out="$("${g[@]}" log --oneline '@{u}..HEAD' -- "${paths[@]}" || true)"
    if [[ -n $out ]]; then echo "$out" | sed 's/^/  /'; found=1; fi
  fi
  if [[ $found -eq 1 ]]; then
    warn "Review the items above before running cargo, git hooks or project scripts on the host."
  else
    log "Nothing found that would execute on the host"
  fi
}

cmd_snapshot() {
  local n="${1:-snap-$(date +%Y%m%d-%H%M%S)}"
  incus snapshot create "$VM" "$n"
  log "Snapshot $n of $VM created (VM disk only; the project folder is not included)"
}

cmd_restore() {
  if [[ $# -ne 1 ]]; then incus snapshot list "$VM"; die "usage: devbox restore [vm] <snapshot>"; fi
  if [[ $(state "$VM") == RUNNING ]]; then incus stop "$VM"; fi
  incus snapshot restore "$VM" "$1"
  log "Restored $VM to $1"
}

cmd_destroy() {
  local a
  read -r -p "Delete VM $VM? The project folder $PROJECT_DIR is not touched. [y/N] " a
  [[ $a == [yY] ]] || exit 0
  incus delete -f "$VM"
  log "Deleted $VM"
}

cmd_uninstall() {
  local a n
  read -r -p "Delete ALL devbox VMs, the proxy, base image, networks, ACL and profile? Project folders are not touched. [y/N] " a
  [[ $a == [yY] ]] || exit 0
  while read -r n; do incus delete -f "$n"; done < <(devbox_vms)
  for n in "$BUILDER" "$PROXY"; do
    if exists "$n"; then incus delete -f "$n"; fi
  done
  incus image delete "$BASE_ALIAS" 2>/dev/null || true
  incus network acl delete "$ACL" 2>/dev/null || true
  incus network delete "$SANDBOX_NET" 2>/dev/null || true
  incus network delete "$UPLINK_NET" 2>/dev/null || true
  incus profile delete "$PROFILE" 2>/dev/null || true
  log "Removed (storage pool '$POOL' kept)"
}

cmd_help() {
  cat <<'EOF'
Usage: devbox <command> [vm] [args]

[vm] can be omitted when you run devbox from inside a project folder.

One-time
  setup                  Install Incus and dependencies on CachyOS (then log out/in)
  build-base             Build or rebuild the shared base image (also creates network + proxy)

Project VMs
  create <name> [path]   New VM for a project (path defaults to the current directory)
  list                   VMs, their project folders, and whether they are on the current base
  recreate [vm]          Rebuild a VM from the current base, keeping its Claude Code, opencode and gh logins
  copy-login <from> <to> Copy the Claude Code and opencode logins between VMs
  gh-login [vm]          Log gh in with a token (prompted, or piped: devbox gh-login vm < file)
  destroy [vm]           Delete a VM (never the project folder)

Daily use
  claude [vm] [args]     Claude Code in the VM (e.g. claude --dangerously-skip-permissions)
  opencode [vm] [args]   opencode in the VM (first run: opencode auth login, or /connect)
  run [vm] <cmd...>      Run a command in the VM (e.g. run cargo test)
  shell [vm]             Interactive shell as you;  root [vm] for a root shell
  start [vm] | stop [vm] Start/stop a VM (stop all with: stop --all)

Network (one proxy and domain list shared by all VMs)
  allow <domain>...      Allow a domain and its subdomains (saved in ~/.config/devbox/domains.txt)
  deny <domain>...       Deny a domain and its subdomains, even if a default allows it
  reload-proxy           Push the domain lists after editing ~/.config/devbox/domains.txt
  denied [vm]            Refused domains by count (optionally for one VM)
  log                    Follow the proxy access log
  lock | unlock [vm]     Lock the proxy / open it for one VM only

Safety and maintenance
  verify [vm]            Re-run the containment checks
  audit [vm]             Check the project for changes that would execute on the host
  snapshot [vm] [name]   Snapshot the VM disk;  restore [vm] <name>
  update [vm]            Update apt, Rust, Claude Code, opencode and cargo-nextest inside one VM
  uninstall              Delete everything devbox created (never project folders)
EOF
}

# ── dispatch ────────────────────────────────────────────────────────────────
cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) cmd_help; exit 0 ;;
  setup)          cmd_setup; exit 0 ;;
  audit)          if command -v incus >/dev/null && incus info >/dev/null 2>&1; then resolve_vm "$@"
                  else PROJECT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"; fi
                  cmd_audit; exit 0 ;;
esac

need_incus
case "$cmd" in
  build-base)   cmd_build_base ;;
  create)       cmd_create "$@" ;;
  list|ls)      cmd_list ;;
  recreate)     cmd_recreate "$@" ;;
  copy-login)   [[ $# -eq 2 ]] || die "usage: devbox copy-login <from> <to>"
                is_devbox "$1" && is_devbox "$2" || die "both must be devbox VMs"
                ensure_running "$1"; ensure_running "$2"; copy_credentials "$1" "$2" ;;
  destroy)      resolve_vm "$@"; cmd_destroy ;;
  gh-login)     resolve_vm "$@"; cmd_gh_login ;;
  claude)       resolve_vm "$@"; shift "$CONSUMED"; ensure_running "$VM"; in_vm claude "$@" ;;
  opencode)     resolve_vm "$@"; shift "$CONSUMED"; ensure_running "$VM"; in_vm opencode "$@" ;;
  run)          resolve_vm "$@"; shift "$CONSUMED"; [[ $# -ge 1 ]] || die "usage: devbox run [vm] <command...>"
                ensure_running "$VM"; in_vm "$@" ;;
  shell)        resolve_vm "$@"; ensure_running "$VM"; in_vm bash ;;
  root)         resolve_vm "$@"; ensure_running "$VM"; incus exec "$VM" -- bash -l ;;
  start)        resolve_vm "$@"; ensure_running "$VM"; log "$VM running" ;;
  stop)         if [[ ${1:-} == --all ]]; then
                  while read -r n; do if [[ $(state "$n") == RUNNING ]]; then incus stop "$n"; fi; done < <(devbox_vms)
                  if exists "$PROXY" && [[ $(state "$PROXY") == RUNNING ]]; then incus stop "$PROXY"; fi
                else
                  resolve_vm "$@"; if [[ $(state "$VM") == RUNNING ]]; then incus stop "$VM"; fi
                fi ;;
  allow|deny)   cmd_allow_deny "$cmd" "$@" ;;
  reload-proxy) cmd_reload_proxy ;;
  denied)       if [[ $# -ge 1 ]]; then resolve_vm "$@"; fi; cmd_denied ;;
  log)          ensure_proxy_running; incus exec "$PROXY" -- tail -n 50 -f /var/log/squid/access.log ;;
  lock)         ensure_proxy_running; proxy_lock; log "Proxy locked to the allowlist" ;;
  unlock)       resolve_vm "$@"; ensure_running "$VM"; proxy_open_for "$VM"
                warn "Proxy is OPEN for $VM; run 'devbox lock' when done" ;;
  verify)       resolve_vm "$@"; cmd_verify ;;
  snapshot)     resolve_vm "$@"; shift "$CONSUMED"; cmd_snapshot "$@" ;;
  restore)      resolve_vm "$@"; shift "$CONSUMED"; cmd_restore "$@" ;;
  update)       resolve_vm "$@"; cmd_update ;;
  uninstall)    cmd_uninstall ;;
  *)            cmd_help; exit 1 ;;
esac
